---
layout: default
---
<link rel="stylesheet" href="{{ '/assets/css/blog.css' | relative_url }}">

<div class="blog-index">
  <h1 class="blog-index-title">{{ page.title | escape }}</h1>

  <div class="blog-posts" id="blog-posts">
    {% for post in site.posts %}
      {% assign words = post.content | strip_html | number_of_words %}
      {% assign reading_minutes = words | plus: 199 | divided_by: 200 | at_least: 1 %}
      {% assign thumbnail = post.thumbnail | default: '/assets/img/blog/notes.svg' %}
      <article class="blog-card">
        <a class="blog-card-link" href="{{ post.url | relative_url }}" aria-labelledby="blog-post-{{ forloop.index }}">
          <div class="blog-card-image">
            <img src="{{ thumbnail | relative_url }}" alt="{{ post.thumbnail_alt | default: '' | escape }}" width="720" height="440" loading="lazy">
          </div>
          <div class="blog-card-content">
            <p class="blog-card-meta">
              <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%B %-d, %Y' }}</time>
              <span aria-hidden="true">·</span>
              <span>{{ reading_minutes }} min read</span>
            </p>
            <h2 id="blog-post-{{ forloop.index }}">{{ post.title | escape }}</h2>
            {% if post.description %}
              <p class="blog-card-description">{{ post.description | escape }}</p>
            {% endif %}
            {% if post.tags.size > 0 %}
              <ul class="blog-card-tags" aria-label="Topics">
                {% for tag in post.tags %}
                  <li>{{ tag | escape }}</li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </a>
      </article>
    {% else %}
      <p class="blog-empty">New notes are on their way.</p>
    {% endfor %}
  </div>
  {{ content }}
</div>
